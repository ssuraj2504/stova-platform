{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Stova credit-backed Free-account deployment; no permanent-free guarantee. Secret values are never CloudFormation parameters.",
  "Parameters": {
    "CloudFrontPrefixListId": {
      "Type": "String",
      "AllowedPattern": "pl-[a-f0-9]+"
    },
    "LatestAmiId": {
      "Type": "AWS::EC2::Image::Id",
      "Description": "Pinned AL2023 x86_64 AMI; script resolves the public SSM parameter only on first creation"
    },
    "GitHubRepo": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "ExistingGitHubOidcArn": {
      "Type": "String",
      "Default": ""
    }
  },
  "Conditions": {
    "GitHubEnabled": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "GitHubRepo"
            },
            ""
          ]
        }
      ]
    },
    "CreateGitHubProvider": {
      "Fn::And": [
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "GitHubRepo"
                },
                ""
              ]
            }
          ]
        },
        {
          "Fn::Equals": [
            {
              "Ref": "ExistingGitHubOidcArn"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.42.0.0/16",
        "EnableDnsHostnames": true,
        "EnableDnsSupport": true
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway"
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "Subnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.1.0/24",
        "MapPublicIpOnLaunch": true,
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        }
      }
    },
    "RouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "RouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet"
        },
        "RouteTableId": {
          "Ref": "RouteTable"
        }
      }
    },
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Stova HTTP origin only from CloudFront; no SSH, database, or API ingress",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8080,
            "ToPort": 8080,
            "SourcePrefixListId": {
              "Ref": "CloudFrontPrefixListId"
            }
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "-1",
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "ReleaseBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireOldReleases",
              "Status": "Enabled",
              "Prefix": "releases/",
              "ExpirationInDays": 30
            },
            {
              "Id": "AbortIncompleteUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        }
      }
    },
    "BucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "ReleaseBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "ReleaseBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${ReleaseBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "HostRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "RuntimeAndSessionManager",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:UpdateInstanceInformation",
                    "ssm:ListInstanceAssociations",
                    "ssm:DescribeAssociation",
                    "ssm:GetDeployablePatchSnapshotForInstance",
                    "ssm:GetDocument",
                    "ssm:DescribeDocument",
                    "ssm:GetManifest",
                    "ssm:PutInventory",
                    "ssm:PutComplianceItems",
                    "ssm:PutConfigurePackageResult",
                    "ssm:ListAssociations",
                    "ssm:UpdateAssociationStatus",
                    "ssm:UpdateInstanceAssociationStatus"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssmmessages:CreateControlChannel",
                    "ssmmessages:CreateDataChannel",
                    "ssmmessages:OpenControlChannel",
                    "ssmmessages:OpenDataChannel",
                    "ec2messages:AcknowledgeMessage",
                    "ec2messages:DeleteMessage",
                    "ec2messages:FailMessage",
                    "ec2messages:GetEndpoint",
                    "ec2messages:GetMessages",
                    "ec2messages:SendReply"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:GetParameter",
                    "ssm:GetParameters"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/stova/${AWS::StackName}/runtime"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${ReleaseBucket.Arn}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${ReleaseBucket.Arn}/backups/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "freetier:GetAccountPlanState"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "HostProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "HostRole"
          }
        ]
      }
    },
    "Instance": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": [
        "InternetRoute",
        "RouteAssociation"
      ],
      "Properties": {
        "ImageId": {
          "Ref": "LatestAmiId"
        },
        "InstanceType": "t3.micro",
        "CreditSpecification": {
          "CPUCredits": "standard"
        },
        "IamInstanceProfile": {
          "Ref": "HostProfile"
        },
        "InstanceInitiatedShutdownBehavior": "stop",
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 1,
          "InstanceMetadataTags": "disabled"
        },
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "SubnetId": {
              "Ref": "Subnet"
            },
            "AssociatePublicIpAddress": true,
            "GroupSet": [
              {
                "Ref": "SecurityGroup"
              }
            ]
          }
        ],
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": 20,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-stova"
            }
          },
          {
            "Key": "Application",
            "Value": "Stova"
          }
        ],
        "UserData": {
          "Fn::Base64": "#!/bin/bash\nset -euo pipefail\numask 077\ndnf install -y docker python3.12 python3.12-pip\nsystemctl enable --now docker\nsystemctl enable --now amazon-ssm-agent\ninstall -d -m 700 /opt/stova /opt/stova/releases\npython3.12 -m venv /opt/stova/tools\n/opt/stova/tools/bin/python -m pip install --quiet 'boto3>=1.43.118,<2'\ninstall -d -m 755 /usr/local/lib/docker/cli-plugins\ncompose_version=v2.39.4\ncompose_base=\"https://github.com/docker/compose/releases/download/$compose_version\"\ncurl --fail --silent --show-error --location \"$compose_base/docker-compose-linux-x86_64\" --output /tmp/stova-compose\ncurl --fail --silent --show-error --location \"$compose_base/docker-compose-linux-x86_64.sha256\" --output /tmp/stova-compose.sha256\nexpected=$(cut -d ' ' -f 1 /tmp/stova-compose.sha256)\nprintf '%s  /tmp/stova-compose\\n' \"$expected\" | sha256sum --check --status\ninstall -m 755 /tmp/stova-compose /usr/local/lib/docker/cli-plugins/docker-compose\nrm -f /tmp/stova-compose /tmp/stova-compose.sha256\ndocker compose version >/dev/null\ntouch /opt/stova/bootstrap-ready\n"
        }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": false,
          "Comment": {
            "Fn::Sub": "Stova ${AWS::StackName}; secret activated by the deployment script"
          },
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_100",
          "Origins": [
            {
              "Id": "stova-origin",
              "DomainName": {
                "Fn::GetAtt": [
                  "Instance",
                  "PublicDnsName"
                ]
              },
              "CustomOriginConfig": {
                "HTTPPort": 8080,
                "HTTPSPort": 443,
                "OriginProtocolPolicy": "http-only",
                "OriginReadTimeout": 60,
                "OriginKeepaliveTimeout": 5
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "stova-origin",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS",
              "PUT",
              "POST",
              "PATCH",
              "DELETE"
            ],
            "CachedMethods": [
              "GET",
              "HEAD",
              "OPTIONS"
            ],
            "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
            "OriginRequestPolicyId": "216adef6-5c7f-47e4-b989-5492eafa07d3",
            "Compress": false
          },
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          }
        }
      }
    },
    "GitHubProvider": {
      "Type": "AWS::IAM::OIDCProvider",
      "Condition": "CreateGitHubProvider",
      "Properties": {
        "Url": "https://token.actions.githubusercontent.com",
        "ClientIdList": [
          "sts.amazonaws.com"
        ]
      }
    },
    "GitHubRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "GitHubEnabled",
      "Properties": {
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::If": [
                    "CreateGitHubProvider",
                    {
                      "Ref": "GitHubProvider"
                    },
                    {
                      "Ref": "ExistingGitHubOidcArn"
                    }
                  ]
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": {
                    "Fn::Sub": "repo:${GitHubRepo}:ref:refs/heads/main"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ReleaseOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "freetier:GetAccountPlanState"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:DescribeStacks"
                  ],
                  "Resource": {
                    "Ref": "AWS::StackId"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "${ReleaseBucket.Arn}/releases/*"
                    },
                    {
                      "Fn::Sub": "${ReleaseBucket.Arn}/bootstrap/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:SendCommand"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/${Instance}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}::document/AWS-RunShellScript"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:GetCommandInvocation"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "ReleaseBucket": {
      "Value": {
        "Ref": "ReleaseBucket"
      }
    },
    "InstanceId": {
      "Value": {
        "Ref": "Instance"
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      }
    },
    "Url": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}"
      }
    },
    "GitHubRoleArn": {
      "Condition": "GitHubEnabled",
      "Value": {
        "Fn::GetAtt": [
          "GitHubRole",
          "Arn"
        ]
      }
    },
    "RuntimeParameter": {
      "Value": {
        "Fn::Sub": "/stova/${AWS::StackName}/runtime"
      }
    }
  }
}
