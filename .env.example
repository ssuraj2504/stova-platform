# Local development only. Generate a fresh secret for every deployment.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
POSTGRES_PASSWORD=stova_dev_only
DATABASE_URL=postgresql+asyncpg://stova:stova_dev_only@127.0.0.1:55432/stova
COOKIE_SECURE=false
ENVIRONMENT=development
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
PORT=8080
BACKEND_URL=http://127.0.0.1:8000
STATIC_DIR=frontend/dist

# Optional shared writing; use the owner's Cloudflare Workers Free account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_FREE_TIER_CONFIRMED=false
